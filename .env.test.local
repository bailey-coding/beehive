# Local E2E Test Environment
# This file is used when E2E_ENVIRONMENT=local

E2E_ENVIRONMENT=local

# API token for local development (mock)
BEEHIVE_API_TOKEN=test-auth-token-12345
STAGING_API_TOKEN=test-auth-token-12345

# Base URLs for local development
BEEHIVE_BASE_URL=http://localhost:8787
SHADOW_ROUTER_URL=http://localhost:8788
CANARY_WORKER_URL=http://localhost:8789
PROMOTION_WORKER_URL=http://localhost:8790

# Test timeouts (in milliseconds)
E2E_TIMEOUT=5000
