# Production E2E Test Environment
# This file is used when E2E_ENVIRONMENT=production

E2E_ENVIRONMENT=production

# API token for production environment (REQUIRED)
# Generate this from your Cloudflare dashboard with appropriate permissions
# This token must have access to:
# - beehive-shadow-router.bz23711.workers.dev
# - beehive-canary-worker.bz23711.workers.dev
# - beehive-promotion-worker.bz23711.workers.dev
BEEHIVE_API_TOKEN=your_production_api_token_here

# Base URLs for production environment (beehive.bz23711.workers.dev)
BEEHIVE_BASE_URL=https://beehive.bz23711.workers.dev
SHADOW_ROUTER_URL=https://beehive-shadow-router.bz23711.workers.dev
CANARY_WORKER_URL=https://beehive-canary-worker.bz23711.workers.dev
PROMOTION_WORKER_URL=https://beehive-promotion-worker.bz23711.workers.dev

# Cloudflare account ID (optional - will be auto-detected if not set)
# CLOUDFLARE_ACCOUNT=bz23711

# Test timeouts (in milliseconds)
E2E_TIMEOUT=15000
