# Staging E2E Test Environment
# This file is used when E2E_ENVIRONMENT=staging

E2E_ENVIRONMENT=staging

# API token for staging environment (REQUIRED)
# Generate this from your Cloudflare dashboard or use a service token
STAGING_API_TOKEN=your_staging_api_token_here

# Base URLs for staging environment
BEEHIVE_BASE_URL=https://beehive-staging.workers.dev
SHADOW_ROUTER_URL=https://beehive-shadow-router-staging.workers.dev
CANARY_WORKER_URL=https://beehive-canary-worker-staging.workers.dev
PROMOTION_WORKER_URL=https://beehive-promotion-worker-staging.workers.dev

# Test timeouts (in milliseconds)
E2E_TIMEOUT=10000
